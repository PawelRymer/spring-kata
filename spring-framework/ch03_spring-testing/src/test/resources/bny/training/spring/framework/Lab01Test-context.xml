<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="vehicle" class="bny.training.spring.framework.model.Vehicle">
        <constructor-arg value="car"/>
        <constructor-arg value="2017"/>
    </bean>

    <bean id="bulkVehicleOrder" class="bny.training.spring.framework.model.BulkVehicleOrder">
        <constructor-arg ref="vehicle"/>
        <constructor-arg value="10"/>
    </bean>

</beans>