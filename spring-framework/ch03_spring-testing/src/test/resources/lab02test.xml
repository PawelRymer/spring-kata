<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="vehicle" class="bny.training.spring.framework.model.Vehicle">
        <property name="type" value="pickup"/>
        <property name="year" value="2016"/>
    </bean>

    <bean id="bulkVehicleOrder" class="bny.training.spring.framework.model.BulkVehicleOrder">
        <property name="vehicle" ref="vehicle"/>
        <property name="quantity" value="7"/>
    </bean>

</beans>